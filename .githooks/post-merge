#!/bin/sh
# Carried over from `cairn init --git`, which installs it in .git/hooks: with
# core.hooksPath pointed here, this copy is the one that runs.
#
# Ids are allocated as one more than the highest in use, which no branch can
# know, so two branches can each create the same one. Git merges them cleanly
# (the filenames differ) and leaves a project that fails `cairn check`. Once the
# merge is settled, renumber any collision, then re-derive the roadmap.
set -eu
command -v cairn >/dev/null 2>&1 || exit 0
cd "$(git rev-parse --show-toplevel)"

cairn renumber --quiet
cairn render --quiet

# A hook cannot amend the merge commit, so anything it changed is left
# unstaged for a person to look at and commit.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "cairn: the merge changed identifiers or the roadmap; review and commit:"
  git status --short | sed "s/^/  /"
fi
