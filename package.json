{
  "name": "loserbb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4242",
    "build": "next build",
    "start": "next start -p 4242",
    "lint": "eslint --max-warnings=0 && tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.5",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.28.1"
}
