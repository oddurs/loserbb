root = true

# Matches .prettierrc.json.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 110

# scripts/agent and the hooks are shell, indented by four.
[{scripts/*,.githooks/*}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
